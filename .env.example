# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=4000

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/kingdom-network

# Auth (placeholders — wire up when you add authentication)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Development only: origin of the Vite dev server, used for CORS.
# Not used in production, where Express serves the client itself.
CLIENT_ORIGIN=http://localhost:5173
