# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=4000

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/kingdom-network

# Auth. In production the server refuses to start on a placeholder.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Development only: origin of the Vite dev server, used for CORS.
# Not used in production, where Express serves the client itself.
CLIENT_ORIGIN=http://localhost:5173

# The origin Pesapal callbacks and emailed links must reach. Required in
# production, where it must be https and a public hostname: the payer's browser
# opens callback_url (so localhost is fine for that), but the IPN is called by
# Pesapal's own servers and loopback is unreachable to them.
PUBLIC_BASE_URL=http://localhost:4000

# Where uploaded media is written. On Render this is the mount path of an
# attached persistent disk, e.g. /var/data/uploads.
UPLOAD_DIR=./server/uploads

# What the platform retains from each payment before settling with the church.
PLATFORM_COMMISSION_PERCENT=10

# Show the seeded demonstration catalogue. Defaults to true outside production.
DEMO_MODE=true

# Pesapal API 3.0.
#   unset   → the built-in mock gateway (no network, no money)
#   sandbox → real Pesapal against cybqa.pesapal.com (test keys, no money)
#   live    → real Pesapal against pay.pesapal.com   (production keys, real money)
#
# Sandbox test keys are published at https://developer.pesapal.com/api3-demo-keys.txt
# Live keys come from the Pesapal merchant dashboard; there is no sandbox toggle
# there, the two environments are separate accounts.
#
# In production the server refuses to start on the mock gateway, because the
# mock fulfils orders — issuing credentials and course access — for free.
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=

# Outbound email. Without a key, mail is printed to the server log.
# RESEND_API_KEY=
MAIL_FROM=Kingdom Network <no-reply@kingdom.network>
