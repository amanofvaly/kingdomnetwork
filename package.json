{
  "name": "kingdom-network",
  "version": "1.0.0",
  "private": true,
  "description": "Kingdom Network — monolithic MERN application (single server, single repo).",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "nodemon server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "postinstall": "npm --prefix client install",
    "lint": "npm --prefix client run lint",
    "seed": "node server/scripts/seed.js",
    "seed:all": "node server/scripts/seed.js --all",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node server/scripts/migrate.js"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ipaddr.js": "^2.5.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.20.1",
    "morgan": "^1.10.1",
    "pdfkit": "^0.20.1",
    "satori": "^0.33.4",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.10",
    "vitest": "^4.1.11"
  }
}
